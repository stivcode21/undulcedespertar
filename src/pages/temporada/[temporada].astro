---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import { CalendarHeart } from 'lucide-astro';
import { todosLosProductos } from '../../data/todos-productos';
import categorias from '../../data/categorias.json';

export function getStaticPaths() {
  return categorias.temporadas.map(t => ({ params: { temporada: t.slug } }));
}

const { temporada } = Astro.params;
const meta = categorias.temporadas.find(t => t.slug === temporada);
const productos = todosLosProductos.filter(p => p.temporadas.includes(temporada));
---

<BaseLayout
  title={`Regalos ${meta?.nombre ?? temporada}`}
  description={`Regalos especiales para ${meta?.nombre}. Desayunos, anchetas, flores y más con entrega en Bogotá.`}
>
  <Breadcrumb items={[{ label: `Temporada: ${meta?.nombre}` }]} />

  <div class="max-w-7xl mx-auto px-4 py-6 md:py-10">
    <div class="mb-6 md:mb-8">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-gray-900">
        {meta?.nombre}
      </h1>
      <p class="text-gray-500 mt-2 text-sm md:text-base">{productos.length} productos disponibles</p>
    </div>

    <div class="productos-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-5">
      {productos.map(p => (
        <ProductCard slug={p.slug} nombre={p.nombre} precio={p.precio} imagen={p.imagen} descripcion={p.descripcion} />
      ))}
    </div>

    {productos.length === 0 && (
      <div class="text-center py-20">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-primary-light flex items-center justify-center">
          <CalendarHeart class="w-8 h-8 text-primary" />
        </div>
        <p class="text-gray-500">Próximamente regalos para esta temporada.</p>
        <a href="/" class="mt-4 inline-block text-primary hover:underline text-sm">Volver al inicio</a>
      </div>
    )}
  </div>
</BaseLayout>
