---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import AgregarAlCarrito from '../../components/carrito/AgregarAlCarrito';
import { Star, Truck, Gift, Banknote } from 'lucide-astro';
import { todosLosProductos, porCategoria } from '../../data/todos-productos';
import { iconosCategoria } from '../../data/iconos-categorias';
import { formatPrecio } from '../../lib/formato';
import categorias from '../../data/categorias.json';

export function getStaticPaths() {
  return todosLosProductos.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const producto = todosLosProductos.find(p => p.slug === slug);

if (!producto) return Astro.redirect('/404');

const precioFormateado = formatPrecio(producto.precio);

// Relacionados: misma categoría, excluyendo este
const relacionados = (porCategoria[producto.categoria ?? ''] ?? [])
  .filter(p => p.slug !== producto.slug)
  .slice(0, 4);

const categoriaMeta = categorias.categorias.find(c => c.slug === producto.categoria);
const IconoCategoria = iconosCategoria[producto.categoria ?? ''];
const ocasionesMeta = categorias.ocasiones.filter(o => producto.ocasiones.includes(o.slug));
const temporadasMeta = categorias.temporadas.filter(t => producto.temporadas.includes(t.slug));

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": producto.nombre,
  "description": producto.descripcion,
  "image": `https://undulcedespertar.co${producto.imagen}`,
  "brand": { "@type": "Brand", "name": "Un Dulce Despertar" },
  "offers": {
    "@type": "Offer",
    "price": producto.precio,
    "priceCurrency": "COP",
    "availability": "https://schema.org/InStock",
    "seller": { "@type": "Organization", "name": "Un Dulce Despertar" }
  }
};
---

<BaseLayout
  title={producto.nombre}
  description={`${producto.nombre} - ${producto.descripcion} Precio: ${precioFormateado}. Entrega a domicilio en Bogotá.`}
  ogImage={producto.imagen}
  schema={schema}
>
  <Breadcrumb
    items={[
      ...(categoriaMeta ? [{ label: categoriaMeta.nombre, href: `/categorias/${producto.categoria}` }] : []),
      { label: producto.nombre },
    ]}
  />

  <!-- ══ PRODUCTO PRINCIPAL ══ -->
  <section class="max-w-7xl mx-auto px-4 py-6 md:py-10">
    <div class="grid md:grid-cols-2 gap-6 md:gap-10 lg:gap-16 items-start">

      <!-- Imagen -->
      <div class="relative">
        <div class="aspect-square rounded-3xl overflow-hidden bg-primary-light shadow-lg">
          <img
            src={producto.imagen}
            alt={producto.nombre}
            class="w-full h-full object-cover"
            onerror="this.style.display='none'"
          />
        </div>
        {producto.destacado && (
          <span class="absolute top-4 left-4 inline-flex items-center gap-1 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full">
            <Star class="w-3.5 h-3.5 fill-white" />
            Más vendido
          </span>
        )}
      </div>

      <!-- Info -->
      <div class="space-y-5 md:space-y-6">
        <!-- Categoría badge -->
        {categoriaMeta && (
          <a
            href={`/categorias/${producto.categoria}`}
            class="inline-flex items-center gap-1.5 bg-primary-light text-primary text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-primary hover:text-white transition-colors"
          >
            {IconoCategoria && <IconoCategoria class="w-3.5 h-3.5" />}
            <span>{categoriaMeta.nombre}</span>
          </a>
        )}

        <h1 class="font-display text-2xl md:text-4xl font-bold text-gray-900 leading-tight">
          {producto.nombre}
        </h1>

        <p class="text-3xl md:text-4xl font-bold text-primary">{precioFormateado}</p>

        <p class="text-gray-600 leading-relaxed text-sm md:text-base">{producto.descripcion}</p>

        <!-- Tags ocasiones -->
        {ocasionesMeta.length > 0 && (
          <div class="flex flex-wrap gap-2">
            <span class="text-xs text-gray-400 font-medium mt-1">Ideal para:</span>
            {ocasionesMeta.map(oc => (
              <a
                href={`/ocasion/${oc.slug}`}
                class="bg-gray-100 hover:bg-primary-light text-gray-600 hover:text-primary text-xs px-3 py-1 rounded-full transition-colors"
              >
                {oc.nombre}
              </a>
            ))}
          </div>
        )}

        <!-- Tags temporadas -->
        {temporadasMeta.length > 0 && (
          <div class="flex flex-wrap gap-2">
            <span class="text-xs text-gray-400 font-medium mt-1">Temporada:</span>
            {temporadasMeta.map(temp => (
              <a
                href={`/temporada/${temp.slug}`}
                class="bg-gray-100 hover:bg-primary-light text-gray-600 hover:text-primary text-xs px-3 py-1 rounded-full transition-colors"
              >
                {temp.nombre}
              </a>
            ))}
          </div>
        )}

        <!-- Separador -->
        <!-- flex+gap en vez de space-y: el astro-island del CTA es display:contents y no recibe margen -->
        <div class="border-t border-gray-100 pt-6 flex flex-col gap-4">
          <!-- CTA principal: carrito -->
          <AgregarAlCarrito
            client:load
            conCantidad
            producto={{ slug: producto.slug, nombre: producto.nombre, precio: producto.precio, imagen: producto.imagen }}
          />

          <!-- Info entrega -->
          <div class="grid grid-cols-3 gap-3">
            {[
              { Icon: Truck,    text: 'Entrega en Bogotá' },
              { Icon: Gift,     text: 'Presentación especial' },
              { Icon: Banknote, text: 'Pago contra entrega' },
            ].map(({ Icon, text }) => (
              <div class="flex flex-col items-center gap-1.5 bg-gray-50 rounded-xl p-3 text-center">
                <Icon class="w-5 h-5 text-primary" />
                <span class="text-xs text-gray-500 leading-tight">{text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ PRODUCTOS RELACIONADOS ══ -->
  {relacionados.length > 0 && (
    <section class="bg-gray-50 py-10 md:py-14">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-gray-900 mb-6 md:mb-8">
          También te puede gustar
        </h2>
        <div class="productos-grid grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
          {relacionados.map(p => (
            <ProductCard
              slug={p.slug}
              nombre={p.nombre}
              precio={p.precio}
              imagen={p.imagen}
              descripcion={p.descripcion}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
