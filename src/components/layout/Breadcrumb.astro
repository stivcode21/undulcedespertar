---
import { ChevronRight } from 'lucide-astro';

interface Props {
  // El último item es la página actual (sin href)
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bg-gray-50 border-b border-gray-100">
  <ol class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-1.5 text-sm text-gray-500">
    <li class="shrink-0">
      <a href="/" class="hover:text-primary transition-colors">Inicio</a>
    </li>
    {items.map(item => (
      <li class="flex items-center gap-1.5 min-w-0">
        <ChevronRight class="w-3.5 h-3.5 shrink-0 text-gray-300" />
        {item.href
          ? <a href={item.href} class="hover:text-primary transition-colors whitespace-nowrap">{item.label}</a>
          : <span class="text-gray-800 font-medium truncate" aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
