---
---

<footer class="bg-dark text-white pt-16 pb-8 mt-20">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-10 border-b border-white/10">

      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="inline-block mb-4">
          <img
            src="/assets/images/cropped-logo-e1726550977726.png"
            alt="Un Dulce Despertar"
            class="h-16 w-auto"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='block'"
          />
          <span class="font-bold text-xl text-primary leading-tight hidden">Un Dulce Despertar</span>
        </a>
        <p class="text-sm text-gray-400 leading-relaxed">
          Pioneros en desayunos sorpresa desde 2007. Creando momentos inolvidables con amor y dedicación.
        </p>
        <div class="flex gap-3 mt-5">
          <a href="https://facebook.com" target="_blank" rel="noopener" class="w-9 h-9 bg-white/10 hover:bg-primary rounded-full flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener" class="w-9 h-9 bg-white/10 hover:bg-primary rounded-full flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path fill="black" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="black" stroke-width="2"/></svg>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener" class="w-9 h-9 bg-white/10 hover:bg-primary rounded-full flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon fill="black" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
          </a>
        </div>
      </div>

      <!-- Productos -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-4">Productos</h4>
        <ul class="space-y-2 text-sm text-gray-300">
          <li><a href="/categorias/anchetas" class="hover:text-primary transition-colors">Anchetas</a></li>
          <li><a href="/categorias/desayunos" class="hover:text-primary transition-colors">Desayunos</a></li>
          <li><a href="/categorias/flores" class="hover:text-primary transition-colors">Flores</a></li>
          <li><a href="/categorias/frutas" class="hover:text-primary transition-colors">Frutas</a></li>
          <li><a href="/categorias/corporativos" class="hover:text-primary transition-colors">Corporativos</a></li>
        </ul>
      </div>

      <!-- Ocasiones -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-4">Ocasiones</h4>
        <ul class="space-y-2 text-sm text-gray-300">
          <li><a href="/ocasion/cumpleanos" class="hover:text-primary transition-colors">Cumpleaños</a></li>
          <li><a href="/ocasion/aniversario" class="hover:text-primary transition-colors">Aniversario</a></li>
          <li><a href="/ocasion/grado" class="hover:text-primary transition-colors">Grado</a></li>
          <li><a href="/ocasion/agradecimiento" class="hover:text-primary transition-colors">Agradecimiento</a></li>
          <li><a href="/ocasion/mejorate-pronto" class="hover:text-primary transition-colors">Mejórate Pronto</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-4">Contacto</h4>
        <ul class="space-y-3 text-sm text-gray-300">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>Bogotá: 305 3693139</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>Miami: +1 954 7620304</span>
          </li>
          <li>
            <a href="https://wa.me/573053693139" target="_blank" class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-full text-xs font-semibold transition-colors w-fit mt-2">
              Escríbenos por WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500">
      <p>© 2024 Un Dulce Despertar. Todos los derechos reservados.</p>
      <p>Hecho con amor en Bogotá, Colombia 🇨🇴</p>
    </div>
  </div>
</footer>

