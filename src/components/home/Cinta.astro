---
import { Truck, Star, Award, Gift, Banknote, Headset, Flower2, Package } from 'lucide-astro';

const items = [
  { Icon: Truck,    text: 'Entrega a domicilio en Bogotá' },
  { Icon: Star,     text: '+5.000 clientes felices' },
  { Icon: Award,    text: 'Pioneros desde 2007' },
  { Icon: Gift,     text: 'Presentación especial incluida' },
  { Icon: Banknote, text: 'Pago contra entrega' },
  { Icon: Headset,  text: 'Atención personalizada' },
  { Icon: Flower2,  text: 'Flores frescas garantizadas' },
  { Icon: Package,  text: '+100 productos disponibles' },
];

// Duplicamos para el loop infinito
const repeated = [...items, ...items];
---

<div class="bg-primary overflow-hidden py-2.5">
  <div class="ticker-track flex gap-0 whitespace-nowrap">
    {repeated.map(({ Icon, text }) => (
      <span class="inline-flex items-center gap-2 px-4 md:px-6 text-white text-xs md:text-sm font-medium shrink-0">
        <Icon class="w-4 h-4 shrink-0" />
        <span>{text}</span>
        <span class="text-pink-300 mx-2">•</span>
      </span>
    ))}
  </div>
</div>

<style>
  .ticker-track {
    animation: ticker 30s linear infinite;
    width: max-content;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  @keyframes ticker {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
