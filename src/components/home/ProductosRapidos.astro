---
import { Flame } from 'lucide-astro';
import { todosLosProductos } from '../../data/todos-productos';
import { formatPrecio } from '../../lib/formato';

const destacados = todosLosProductos.filter(p => p.destacado).slice(0, 6);
---

<section class="bg-white border-b border-gray-100 py-4 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center gap-3 mb-3">
      <span class="inline-flex items-center gap-1.5 bg-primary text-white text-sm font-bold px-4 py-1.5 rounded-full">
        <Flame class="w-4 h-4" />
        Más vendidos
      </span>
      <a href="/categorias/regalos" class="text-sm font-bold text-primary hover:underline ml-auto shrink-0">Ver todos →</a>
    </div>

    <!-- py-4 da espacio para que el tilt no se corte en Y; -mx-4 deja que el scroll llegue al borde en mobile -->
    <div class="flex gap-3 overflow-x-auto scrollbar-hide snap-x snap-mandatory py-4 -my-4 -mx-4 px-4 scroll-px-4 md:mx-0 md:px-1 md:scroll-px-1">
      {destacados.map(p => (
        <a
          href={`/producto/${p.slug}`}
          class="quick-card flex items-center gap-3 bg-gray-50 hover:bg-primary-light border border-gray-100 hover:border-primary/20 rounded-2xl p-3 min-w-[220px] max-w-[220px] snap-start shrink-0 group"
        >
          <div class="w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-primary-light">
            <img
              src={p.imagen}
              alt={p.nombre}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-semibold text-gray-800 line-clamp-2 leading-tight group-hover:text-primary transition-colors">{p.nombre}</p>
            <p class="text-primary font-bold text-sm mt-1">{formatPrecio(p.precio)}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .quick-card {
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
    will-change: transform;
  }

  /* Solo en dispositivos con mouse real */
  @media (hover: hover) and (pointer: fine) {
    .quick-card:nth-child(odd):hover {
      transform: perspective(600px) rotateY(-6deg) translateY(-5px);
      box-shadow: 5px 10px 24px rgba(240, 53, 107, 0.18);
    }
    .quick-card:nth-child(even):hover {
      transform: perspective(600px) rotateY(6deg) translateY(-5px);
      box-shadow: -5px 10px 24px rgba(240, 53, 107, 0.18);
    }
  }
</style>
