---
import AgregarAlCarrito from '../carrito/AgregarAlCarrito';
import { formatPrecio } from '../../lib/formato';

interface Props {
  slug: string;
  nombre: string;
  precio: number;
  imagen: string;
  descripcion?: string;
}

const { slug, nombre, precio, imagen, descripcion } = Astro.props;
---

<!-- overflow:visible en article para que el tilt no se corte -->
<article class="product-card group flex flex-col h-full bg-white rounded-2xl shadow-sm hover:shadow-xl border border-gray-100">

  <!-- imagen con su propio overflow-hidden y border-radius -->
  <a href={`/producto/${slug}`} class="block relative aspect-square rounded-t-2xl overflow-hidden bg-primary-light">
    <img
      src={imagen}
      alt={nombre}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
      onerror="this.style.display='none'"
    />
  </a>

  <!-- flex-1 + mt-auto: precio y botón quedan alineados abajo en todas las cards -->
  <div class="flex flex-col flex-1 p-3 md:p-4">
    <a href={`/producto/${slug}`}>
      <h3 class="font-semibold text-gray-800 text-sm leading-snug line-clamp-2 min-h-[2lh] hover:text-primary transition-colors">
        {nombre}
      </h3>
    </a>

    {descripcion && (
      <p class="hidden md:block text-xs text-gray-400 mt-1 line-clamp-2 leading-relaxed">{descripcion}</p>
    )}

    <div class="mt-auto pt-3 space-y-2.5">
      <p class="font-bold text-primary text-base md:text-lg">{formatPrecio(precio)}</p>
      <AgregarAlCarrito client:visible producto={{ slug, nombre, precio, imagen }} />
    </div>
  </div>
</article>

<style>
  .product-card {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
    will-change: transform;
  }

  /* Solo en dispositivos con mouse real — no afecta touch/mobile */
  @media (hover: hover) and (pointer: fine) {
    .product-card:nth-child(odd):hover {
      transform: perspective(900px) rotateY(-5deg) rotateX(2deg) translateY(-8px);
      box-shadow: 6px 16px 32px rgba(240, 53, 107, 0.15);
    }
    .product-card:nth-child(even):hover {
      transform: perspective(900px) rotateY(5deg) rotateX(2deg) translateY(-8px);
      box-shadow: -6px 16px 32px rgba(240, 53, 107, 0.15);
    }
  }
</style>
